# >>> IDE and configuration files <<< #

.vscode
.idea
lcov.info
.cargo

# >>> Temporary files <<< #

tmp*
tmp
profile
tarpaulin-report.html
/coverage/
book
*.npy
repomix-output*

# >>> Bindgen <<< #
blas_bindgen.h

# >>> Python <<< #

.ipynb_checkpoints/
__pycache__/
*.pyc

# >>> Rust/Cargo <<< #

# will have compiled files and executables
debug/
target/
build/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# >>> Code Agent <<< #

# Agent of RSTSR will be maintained in repository `RESTGroup/rstsr-agents`, and you can symlink
# the related directory/files here.

# Agent directory
.claude
.agents
.claude.json
.codex

# Aider chat history & caches
.aider*

# Cursor / Continue / Roo local state (shared rules are committed separately)
.cursor/
.continue/
.roo/

# Catch-all for local-only files (e.g. *.local.toml, *.local.md)
*.local*

# CLAUDE.md or AGENTS.md at root directory
# Developer should customize their own file, and `.claude.rstsr/CLAUDE.md` serves as template
/CLAUDE.md
/AGENTS.md
